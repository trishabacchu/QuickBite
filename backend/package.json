{
  "name": "quickbite-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Express API for QuickBite",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:init": "node src/scripts/init-databases.js",
    "seed": "node src/scripts/seed.js",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest --no-file-parallelism"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cassandra-driver": "^4.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^4.22.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
