# =============================================================================
# QuickBite local development environment
# Copy this file to .env:  npm run dev will do this automatically if missing.
# These values are for LOCAL DEVELOPMENT ONLY. Never use them in production.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Browser origin allowed to send credentialed requests.
FRONTEND_ORIGIN=http://localhost:5173

# --- MongoDB -----------------------------------------------------------------
# Compose creates this root user. The password is local-only.
MONGO_ROOT_USERNAME=quickbite
MONGO_ROOT_PASSWORD=quickbite_dev_password
MONGO_PORT=27017
MONGODB_URI=mongodb://quickbite:quickbite_dev_password@localhost:27017/quickbite?authSource=admin
MONGODB_DB_NAME=quickbite

# --- Cassandra ---------------------------------------------------------------
CASSANDRA_CONTACT_POINTS=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_LOCAL_DATACENTER=datacenter1
CASSANDRA_KEYSPACE=quickbite
# Leave blank for the local Docker setup, which has authentication disabled.
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=

# --- Authentication ----------------------------------------------------------
# Local-only secret. Replace with at least 32 random characters in production.
JWT_SECRET=local_quickbite_jwt_secret_replace_me_32_chars_minimum
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=quickbite_token
# false locally because the app runs over http://localhost.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- Workers and demonstration timings --------------------------------------
ENABLE_WORKERS=true
# Simulated lifecycle: a new status is applied approximately this often.
ORDER_STATUS_INTERVAL_MS=12000
ORDER_WORKER_POLL_INTERVAL_MS=2000
OUTBOX_WORKER_POLL_INTERVAL_MS=2000
OUTBOX_BASE_DELAY_MS=2000
OUTBOX_MAX_DELAY_MS=120000
OUTBOX_BATCH_SIZE=20
# Number of statuses to advance when catching up after a restart.
ORDER_WORKER_BATCH_SIZE=20

# --- Demo data ---------------------------------------------------------------
# Set AUTO_SEED=false if you want to keep a hand-curated local database.
AUTO_SEED=true
DEMO_CUSTOMER_NAME=Demo Customer
DEMO_CUSTOMER_EMAIL=demo@quickbite.local
DEMO_CUSTOMER_PASSWORD=Demo@123

# --- Frontend (public, no secrets) ------------------------------------------
# Vite proxies /api to the backend in development, so this can stay blank.
VITE_API_URL=
